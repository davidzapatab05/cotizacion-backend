{
  "name": "motos-cotizador-backend",
  "version": "1.0.0",
  "description": "Backend API para Cotizador de Motos Multi-Sede (Piloto Piura)",
  "author": "Senior Software Architect",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node --no-warnings=DEP0190 ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --no-warnings=DEP0190 ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --no-warnings=DEP0190 ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node --no-warnings=DEP0190 dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.2.18",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfmake": "^0.2.11",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
