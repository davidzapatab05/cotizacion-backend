datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN_SEDE
  VENDEDOR
  AUDITOR
}

enum CotizacionEstado {
  BORRADOR
  EMITIDA
  APROBADA
  RECHAZADA
  CONVERTIDA_A_VENTA
  VENCIDA
}

enum TipoDocumento {
  DNI
  RUC
  CE
  PASAPORTE
}

model Sede {
  id           String   @id @default(uuid())
  codigo       String   @unique // Ej: "PIU-01"
  nombre       String   // Ej: "Sede Principal Piura"
  direccion    String   // Ej: "Av. Sánchez Cerro 1234, Piura"
  ciudad       String   @default("Piura")
  departamento String   @default("Piura")
  telefono     String?  // Ej: "(073) 304050"
  ruc          String?  // Ej: "20123456789"
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usuarios             Usuario[]
  usuariosPermitidos   UsuarioSede[]
  inventario           InventarioSede[]
  cotizaciones         Cotizacion[]
  configuracionesSede  ConfiguracionFinanciera[]

  @@index([activo])
  @@index([codigo])
}

model Usuario {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  nombres         String
  apellidos       String
  telefono        String?
  codigoVendedor  String?  @unique // Ej: "VEN-PIU-001"
  rol             Role     @default(VENDEDOR)
  sedeId          String
  sede            Sede     @relation(fields: [sedeId], references: [id])
  accesoTodasSedes Boolean @default(false)
  sedesPermitidas UsuarioSede[]
  activo          Boolean  @default(true)
  descuentoMaximo Decimal  @default(0.00) @db.Decimal(5, 2) // % max descuento que puede aplicar sin autorización
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cotizacionesCreadas    Cotizacion[] @relation("VendedorCotizaciones")
  cotizacionesAprobadas  Cotizacion[] @relation("AprobadorCotizaciones")
  auditorias             Auditoria[]
  permisosDirectos       UsuarioPermiso[]
  movimientosStock       MovimientoStock[]

  @@index([sedeId, rol, activo])
  @@index([codigoVendedor])
  @@index([email])
}

model Permiso {
  id          String   @id @default(uuid())
  codigo      String   @unique // Ej: "catalogo:ver", "catalogo:crear", "cotizaciones:editar", etc.
  modulo      String   // Ej: "catalogo", "cotizaciones", "usuarios", "roles", "auditoria"
  accion      String   // Ej: "ver", "crear", "editar", "eliminar"
  descripcion String?

  rolesPermisos    RolPermiso[]
  usuariosPermisos UsuarioPermiso[]

  @@unique([modulo, accion])
  @@index([modulo])
}

model RolDefinicion {
  id          String   @id @default(uuid())
  nombre      String   @unique // Ej: "SUPER_ADMIN", "ADMIN_SEDE", "VENDEDOR", etc.
  descripcion String?
  esSistema   Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permisos    RolPermiso[]

  @@index([activo])
}

model RolPermiso {
  id        String        @id @default(uuid())
  rolId     String
  permisoId String
  rol       RolDefinicion @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso       @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([rolId, permisoId])
}

model UsuarioPermiso {
  id        String   @id @default(uuid())
  usuarioId String
  permisoId String
  concedido Boolean  @default(true) // true = otorgado individualmente, false = revocado
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso   Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permisoId])
}

model UsuarioSede {
  id        String   @id @default(uuid())
  usuarioId String
  sedeId    String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sede      Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([usuarioId, sedeId])
  @@index([usuarioId])
  @@index([sedeId])
}

model Marca {
  id         String   @id @default(uuid())
  nombre     String   @unique // Normalizado en MAYUSCULAS: "HONDA", "BAJAJ", "YAMAHA"
  paisOrigen String?  // Ej: "JAPON", "INDIA"
  logoUrl    String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  motos      Moto[]

  @@index([activo])
  @@index([nombre])
}

enum TipoMovimientoStock {
  INGRESO_LOTE
  VENTA_ENTREGA
  DEVOLUCION_DEFECTO
  AJUSTE_INVENTARIO
  TRASPASO_SEDE
}

model Moto {
  id                      String   @id @default(uuid())
  marcaId                 String?
  marca                   String   // Ej: "HONDA", "BAJAJ", "YAMAHA"
  modelo                  String   // Ej: "CB190R", "Pulsar NS200", "FZ-25"
  version                 String?  // Ej: "ABS 2026", "Fi"
  anio                    Int      @default(2026)
  cilindradaCc            Int      // Ej: 184, 199, 250
  tipoMotor               String?  // Ej: "4 Tiempos, Monocilindrico 4V"
  potenciaHp              Decimal? @db.Decimal(5, 2) // Ej: 16.00, 24.10
  torqueNm                Decimal? @db.Decimal(5, 2)
  sistemaFrenos           String?  // Ej: "Disco delantero ABS / Disco posterior"
  capacidadTanqueGal      Decimal? @db.Decimal(4, 2)
  rendimientoKmGal        Decimal? @db.Decimal(6, 2)
  fichaTecnicaUrl         String?
  precioBase              Decimal  @db.Decimal(10, 2) // Precio de lista en Soles
  porcentajeInicialMinima Decimal  @default(30.00) @db.Decimal(5, 2) // Ej: 30% minimo
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  marcaRel        Marca?           @relation(fields: [marcaId], references: [id])
  imagenes        MotoImagen[]
  inventarioSedes InventarioSede[]
  cotizaciones    Cotizacion[]

  @@index([activo, marca, modelo])
  @@index([precioBase])
  @@index([marcaId])
}

model MotoImagen {
  id          String   @id @default(uuid())
  motoId      String
  moto        Moto     @relation(fields: [motoId], references: [id], onDelete: Cascade)
  url         String
  esPrincipal Boolean  @default(false)
  orden       Int      @default(0)

  @@index([motoId, esPrincipal])
}

model InventarioSede {
  id          String            @id @default(uuid())
  sedeId      String
  motoId      String
  color       String            // Ej: "ROJO / BLANCO", "NEGRO MATE"
  stock       Int               @default(0)
  precioSede  Decimal?          @db.Decimal(10, 2) // Opcional sobrecosto flete
  sede        Sede              @relation(fields: [sedeId], references: [id])
  moto        Moto              @relation(fields: [motoId], references: [id])
  movimientos MovimientoStock[]

  @@unique([sedeId, motoId, color])
  @@index([sedeId, stock])
  @@index([motoId])
}

model MovimientoStock {
  id            String              @id @default(uuid())
  inventarioId  String
  tipo          TipoMovimientoStock @default(INGRESO_LOTE)
  cantidad      Int                 // Unidades afectadas
  stockAnterior Int
  stockNuevo    Int
  motivo        String              // Ej: "Ingreso lote importacion", "Venta cotizacion COT-PIU-2026-00001", "Devolucion defecto de fabrica"
  usuarioId     String?
  createdAt     DateTime            @default(now())

  inventario    InventarioSede      @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  usuario       Usuario?            @relation(fields: [usuarioId], references: [id])

  @@index([inventarioId, createdAt(sort: Desc)])
  @@index([tipo])
}

model Cliente {
  id            String        @id @default(uuid())
  tipoDocumento TipoDocumento @default(DNI)
  numeroDoc     String        @unique
  nombres       String
  apellidos     String
  codigoPais    String        @default("+51")
  telefono      String
  email         String?
  direccion     String?
  ciudad        String        @default("Piura")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cotizaciones  Cotizacion[]

  @@index([numeroDoc])
  @@index([telefono])
  @@index([apellidos, nombres])
}

model Cotizacion {
  id                  String           @id @default(uuid())
  correlativoSede     String           // Ej: "COT-PIU-2026-00001"
  sedeId              String
  vendedorId          String
  aprobadoPorId       String?
  clienteId           String
  motoId              String
  colorSeleccionado   String?
  
  // Snapshot inmutable de precios y condiciones al cotizar
  precioListaMoto     Decimal          @db.Decimal(10, 2)
  descuentoMonto      Decimal          @default(0.00) @db.Decimal(10, 2)
  precioFinalVenta    Decimal          @db.Decimal(10, 2)
  
  // Cálculo financiero
  montoInicial        Decimal          @db.Decimal(10, 2)
  porcentajeInicial   Decimal          @db.Decimal(5, 2)
  saldoAFinanciar     Decimal          @db.Decimal(10, 2)
  plazoMeses          Int              // 12, 18, 24
  periodicidad        String           @default("SEMANAL")
  cuotaEstimada       Decimal          @db.Decimal(10, 2)
  costoFijoSemanal    Decimal          @default(0.00) @db.Decimal(10, 2) // Seguro/GPS
  tasaFactorAplicada  Decimal          @default(0.000000) @db.Decimal(10, 6)
  
  // Adicionales, Trámites y Firma Táctil en Salón
  totalAdicionales    Decimal          @default(0.00) @db.Decimal(10, 2)
  adicionalesJson     String?          // JSON con casco, SOAT, GPS, trámites
  firmaClienteBase64  String?          // Firma táctil capturada en tablet/móvil

  // Control de estado y PWA
  estado              CotizacionEstado @default(EMITIDA)
  observaciones       String?
  fechaVigencia       DateTime
  sincronizadoOffline Boolean          @default(false)
  uuidLocalOffline    String?          @unique
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  sede        Sede     @relation(fields: [sedeId], references: [id])
  vendedor    Usuario  @relation("VendedorCotizaciones", fields: [vendedorId], references: [id])
  aprobadoPor Usuario? @relation("AprobadorCotizaciones", fields: [aprobadoPorId], references: [id])
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  moto        Moto     @relation(fields: [motoId], references: [id])

  @@index([sedeId, createdAt(sort: Desc)])
  @@index([vendedorId, createdAt(sort: Desc)])
  @@index([clienteId])
  @@index([estado])
  @@index([correlativoSede])
}

model ConfiguracionFinanciera {
  id                  String   @id @default(uuid())
  sedeId              String?  // null = Configuración Corporativa Global, valor = override por sede
  entidadFinanciera   String   @default("Global Go") // Ej: "Global Go", "Directo Concesionaria"
  plazoMeses          Int      // 12, 18, 24
  factorVariableSaldo Decimal  @db.Decimal(10, 6) // Ej: 0.028571 para 12m
  costoFijoSemanal    Decimal  @db.Decimal(10, 2) // Ej: 5.47 para 12m (GPS/Seguro)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sede                Sede?    @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, entidadFinanciera, plazoMeses])
  @@index([entidadFinanciera, activo])
}

model Auditoria {
  id            String   @id @default(uuid())
  usuarioId     String?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  accion        String   // "COTIZACION_CREADA", "MODIFICACION_PRECIO", "APROBACION_DESCUENTO", "LOGIN"
  entidad       String   // "Cotizacion", "Moto", "Usuario"
  entidadId     String
  valoresPrevios Json?
  valoresNuevos  Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
